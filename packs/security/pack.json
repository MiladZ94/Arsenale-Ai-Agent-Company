        "payment": "never"
      },
      "secrets-scanner": {
        "message.send": "never",
        "post.public": "never",
        "payment": "never"
      },
      "threat-modeller": {
        "message.send": "never",
        "post.public": "never",
        "payment": "never"
      }
    }
  }
