{
  "format": "arsenale-pack",
  "formatVersion": 1,
  "id": "release",
  "version": "1.0.0",
  "name": "Release",
  "description": "Prepare a release: version, notes, build record and an install check. It never pushes, tags or publishes.",
  "minArsenale": "1.0.0",
  "office": {
    "id": "release",
    "name": "Release",
    "theme": "amber",
    "profile": "release",
    "lead": "release-lead"
  },
  "members": [
    {
      "file": "agents/release-lead.md",
      "id": "release-lead",
      "zone": "lead",
      "title": "Release Lead",
      "tier": "standard"
    },
    {
      "file": "agents/release-notes-writer.md",
      "id": "release-notes-writer",
      "zone": "docs",
      "title": "Release Notes Writer",
      "tier": "standard"
    },
    {
      "file": "agents/install-tester.md",
      "id": "install-tester",
      "zone": "ship",
      "title": "Install Tester",
      "tier": "light"
    },
    {
      "id": "release-manager",
      "ref": true,
      "zone": "build",
      "title": "Release Manager",
      "tier": "standard"
    },
    {
      "id": "release-builder",
      "ref": true,
      "zone": "build",
      "title": "Release Builder",
      "tier": "standard"
    }
  ],
  "sampleTasks": [
    {
      "title": "Write release notes for a small version",
      "description": "From the invented list of merged requests I name, write the changelog entry and the short release notes.",
      "assignee": "release-notes-writer"
    },
    {
      "title": "Write the install check for a new build",
      "description": "For an invented desktop build, list the install, run and uninstall steps with the expected result of each.",
      "assignee": "install-tester"
    }
  ],
  "policy": {
    "members": {
      "release-lead": {
        "message.send": "never",
        "post.public": "never",
        "payment": "never"
      },
      "release-notes-writer": {
        "message.send": "never",
        "post.public": "never",
        "payment": "never"
      },
      "install-tester": {
        "message.send": "never",
        "post.public": "never",
        "payment": "never"
      }
    }
  }
}
